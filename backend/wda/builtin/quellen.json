{
 "format": "wda-definitions",
 "version": 1,
 "builtin": {
  "id": "quellen",
  "title": "Quellen",
  "description": "Datenprobleme und Merkmale mit Bezug zu den Quellen, nach dem Vorbild des Quellenpanels: Datenströme (Bestand, Zufluss, Pflege), Größe und Bindung der Quellen, dünne Metadaten, Kosten, Werbung, Zugang, Datenschutz und Erschließung je Bezugsquelle, Vollständigkeit der Quelldatensätze."
 },
 "groups": [
  {
   "id": "builtin-berichte",
   "name": "Mitgelieferte Berichte"
  }
 ],
 "definitions": [
  {
   "id": "builtin-quellen",
   "kind": "dashboard",
   "name": "Quellen",
   "description": "Quellen im Blick, allein aus Zählungen. „Quelle“ ist der Crawler (ccm:replicationsource), „Bezugsquelle“ der Anbieter (ccm:oeh_publisher_combined). Anteile je Bezugsquelle beziehen sich auf deren Materialien. Einzelne Materialien oder Quelldatensätze werden nicht gezeigt.",
   "group_id": "builtin-berichte",
   "spec": {
    "instance": "wlo-prod",
    "tiles": [
     {
      "id": "strom-quellen",
      "title": "Datenströme der Quellen (Crawler): Bestand, Zufluss und Pflege (30 größte). Kein Zufluss und alles unberührt heißt: der Strom ist versiegt",
      "query": {
       "instance": "wlo-prod",
       "filters": [],
       "rows": {
        "property": "ccm:replicationsource",
        "top": 30
       },
       "series": [
        {
         "id": "gesamt",
         "label": "Bestand"
        },
        {
         "id": "neu30",
         "label": "neu in 30 Tagen",
         "filters": [
          {
           "property": "virtual:time_after_created",
           "values": [
            {
             "since": "30d"
            }
           ]
          }
         ]
        },
        {
         "id": "neu12",
         "label": "neu in 12 Monaten",
         "filters": [
          {
           "property": "virtual:time_after_created",
           "values": [
            {
             "since": "12m"
            }
           ]
          }
         ]
        },
        {
         "id": "zufluss",
         "label": "Zufluss 12 Monate %",
         "formula": "round(neu12 / gesamt * 100, 2)"
        },
        {
         "id": "gepflegt",
         "label": "in 12 Monaten geändert",
         "filters": [
          {
           "property": "virtual:time_after_modified",
           "values": [
            {
             "since": "12m"
            }
           ]
          }
         ],
         "hidden": true
        },
        {
         "id": "ruhend",
         "label": "seit 12 Monaten unberührt",
         "formula": "gesamt - gepflegt"
        },
        {
         "id": "ruhend_anteil",
         "label": "unberührt %",
         "formula": "round((gesamt - gepflegt) / gesamt * 100, 1)"
        }
       ]
      },
      "view": {
       "type": "heatmap",
       "options": {
        "zero": "plain",
        "scale_by": "column"
       }
      },
      "layout": {
       "x": 0,
       "y": 0,
       "w": 12,
       "h": 11
      }
     },
