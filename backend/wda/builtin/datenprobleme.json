     {
      "id": "lizenz-je-quelle",
      "title": "Lizenzlage je Quelle (25 größte): offen, eingeschränkt, eigene, ohne Angabe",
      "query": {
       "instance": "wlo-prod",
       "filters": [],
       "series": [
        {
         "id": "gesamt",
         "label": "Gesamt"
        },
        {
         "id": "offen",
         "label": "offen (PD, CC0, CC BY, CC BY-SA)",
         "filters": [
          {
           "property": "license",
           "values": [
            "OPEN",
            "CC_BY_OPEN"
           ]
          }
         ]
        },
        {
         "id": "nc_nd",
         "label": "CC mit NC/ND",
         "filters": [
          {
           "property": "license",
           "values": [
            "CC_BY_RESTRICTED"
           ]
          }
         ]
        },
        {
         "id": "copyright",
         "label": "urheberrechtlich geschützt",
         "filters": [
          {
           "property": "license",
           "values": [
            "COPYRIGHT_OTHERS"
           ]
          }
         ]
        },
        {
         "id": "custom",
         "label": "eigene Lizenz (CUSTOM)",
         "filters": [
          {
           "property": "ccm:commonlicense_key",
           "values": [
            {
             "value": "CUSTOM",
             "literal": true
            }
           ]
          }
         ]
        },
        {
         "id": "mit",
         "label": "mit Lizenzangabe",
         "filters": [
          {
           "property": "ccm:commonlicense_key",
           "values": [
            {
             "value": "",
             "literal": true
            }
           ]
          }
         ]
        },
        {
         "id": "ohne",
         "label": "ohne Lizenzangabe",
         "formula": "gesamt - mit"
        }
       ],
       "rows": {
        "property": "ccm:replicationsource",
        "top": 25
