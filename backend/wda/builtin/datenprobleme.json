  {
   "id": "builtin-datenprobleme",
   "kind": "dashboard",
   "name": "Datenprobleme",
   "description": "Hinweise auf Datenprobleme, allein aus Zählungen. Ampel: unter 50 % rot, unter 80 % gelb. Werte außerhalb des Vokabulars sind Feldwerte mit ihrer Häufigkeit, keine einzelnen Materialien. Gemessen an WLO Produktion.",
   "group_id": "builtin-berichte",
   "spec": {
    "instance": "wlo-prod",
    "tiles": [
     {
      "id": "kernangaben",
      "title": "Fehlende Kernangaben: wie vollständig sind die wichtigsten Felder?",
      "query": {
       "instance": "wlo-prod",
       "filters": [],
       "fill": {
        "fields": [
         {
          "property": "ccm:taxonid",
          "label": "Fach"
         },
         {
          "property": "ccm:educationalcontext",
          "label": "Bildungsstufe"
         },
         {
          "property": "ccm:oeh_lrt_aggregated",
          "label": "Materialart"
         },
         {
          "property": "ccm:commonlicense_key",
          "label": "Lizenz"
         },
         {
          "property": "cclom:general_language",
          "label": "Sprache"
         },
         {
          "property": "ccm:educationalintendedenduserrole",
          "label": "Zielgruppe"
         },
