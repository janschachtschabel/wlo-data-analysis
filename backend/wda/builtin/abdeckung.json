        "vocab": "inside",
        "sort": "label"
       },
       "columns": {
        "property": "ccm:educationalcontext",
        "match": "http://w3id.org/openeduhub/vocabs/educationalContext/",
        "top": 14
       }
      },
      "view": {
       "type": "heatmap"
      },
      "layout": {
