     {
      "id": "schule-lizenz",
      "title": "Schulfächer × Lizenz: wie offen ist das Angebot je Fach?",
      "query": {
       "instance": "wlo-prod",
       "filters": [],
       "rows": {
        "property": "ccm:taxonid",
        "match": "http://w3id.org/openeduhub/vocabs/discipline/",
        "vocab": "inside",
        "sort": "label"
       },
       "series": [
        {
         "id": "gesamt",
         "label": "Gesamt"
        },
        {
         "id": "offen",
         "label": "offen (PD, CC0, CC BY, CC BY-SA)",
         "filters": [
          {
           "property": "license",
           "values": [
            "OPEN",
            "CC_BY_OPEN"
           ]
          }
         ]
        },
        {
         "id": "nc_nd",
         "label": "CC mit NC/ND",
         "filters": [
          {
           "property": "license",
           "values": [
            "CC_BY_RESTRICTED"
           ]
          }
         ]
        },
        {
         "id": "copyright",
         "label": "urheberrechtlich geschützt",
         "filters": [
          {
           "property": "license",
           "values": [
            "COPYRIGHT_OTHERS"
           ]
          }
         ]
        },
        {
         "id": "custom",
         "label": "eigene Lizenz (CUSTOM)",
         "filters": [
          {
           "property": "ccm:commonlicense_key",
           "values": [
            {
             "value": "CUSTOM",
             "literal": true
            }
           ]
          }
         ]
        },
        {
         "id": "mit",
         "label": "mit Lizenzangabe",
         "filters": [
          {
           "property": "ccm:commonlicense_key",
           "values": [
            {
             "value": "",
             "literal": true
            }
           ]
          }
         ]
        },
        {
         "id": "ohne",
         "label": "ohne Lizenzangabe",
         "formula": "gesamt - mit"
        }
       ]
      },
