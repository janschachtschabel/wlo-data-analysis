  {
   "id": "builtin-abdeckung",
   "kind": "dashboard",
   "name": "Abdeckung",
   "description": "Heatmaps der Abdeckung. Je dunkler, desto mehr Materialien; schraffiert bedeutet kein einziges Material. Ein Material mit mehreren Fächern oder Stufen zählt in jeder zutreffenden Zelle. Gemessen an WLO Produktion.",
   "group_id": "builtin-berichte",
   "spec": {
    "instance": "wlo-prod",
    "tiles": [
     {
      "id": "schule-stufe",
      "title": "Schulfächer × Bildungsstufe: wo gibt es Angebot, wo Lücken?",
      "query": {
       "instance": "wlo-prod",
       "filters": [],
       "rows": {
        "property": "ccm:taxonid",
        "match": "http://w3id.org/openeduhub/vocabs/discipline/",
        "vocab": "inside",
        "sort": "label"
       },
       "columns": {
        "property": "ccm:educationalcontext",
        "match": "http://w3id.org/openeduhub/vocabs/educationalContext/",
        "top": 14
       }
      },
      "view": {
       "type": "heatmap"
      },
      "layout": {
       "x": 0,
       "y": 0,
       "w": 12,
       "h": 14
      }
     },
