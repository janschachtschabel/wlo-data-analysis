 "builtin": {
  "id": "datenqualitaet",
  "title": "Datenqualität",
  "description": "Wie vollständig sind die Metadaten? Füllgrade der wichtigsten Felder insgesamt und je Quelle, fehlende Angaben, Verteilungen von Lizenzen, Quellen und Kennzeichen der Redaktion. Alles aus Zählungen, ohne einzelne Datensätze."
 },
 "groups": [
  {
   "id": "builtin-berichte",
   "name": "Mitgelieferte Berichte"
  }
 ],
 "definitions": [
  {
   "id": "builtin-datenqualitaet",
   "kind": "dashboard",
   "name": "Datenqualität",
   "description": "Füllgrade insgesamt und je Quelle, fehlende Angaben, Verteilungen. „Ohne Wert“ ist immer berechnet (Gesamtzahl minus Materialien mit Wert). Gemessen an WLO Produktion; andere Instanzen kennen womöglich nicht alle Felder.",
   "group_id": "builtin-berichte",
   "spec": {
    "instance": "wlo-prod",
    "tiles": [
     {
      "id": "fuellgrade",
      "title": "Füllgrade der wichtigsten Felder",
      "query": {
       "instance": "wlo-prod",
       "filters": [],
       "fill": {
        "fields": [
         {
          "property": "ccm:taxonid",
          "label": "Fach"
         },
         {
          "property": "ccm:educationalcontext",
          "label": "Bildungsstufe"
         },
         {
          "property": "ccm:oeh_lrt_aggregated",
          "label": "Materialart"
         },
         {
          "property": "ccm:commonlicense_key",
          "label": "Lizenz"
         },
         {
          "property": "cclom:general_language",
          "label": "Sprache"
         },
         {
          "property": "ccm:educationalintendedenduserrole",
          "label": "Zielgruppe"
         },
         {
          "property": "ccm:replicationsource",
          "label": "Quelle"
         },
         {
          "property": "ccm:oeh_publisher_combined",
          "label": "Bezugsquelle"
         }
        ]
       }
      },
      "view": {
       "type": "stacked_bar"
      },
      "layout": {
       "x": 0,
       "y": 0,
       "w": 12,
       "h": 6
      }
     },
     {
