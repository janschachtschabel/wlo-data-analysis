# Start-Konfiguration. Alle Felder dürfen leer bleiben: Der erste Start gelingt ohne Angaben.
# Hier stehen keine Geheimnisse; echte Werte gehören nur in die .env auf dem Server.

# Hostname, unter dem die App über Traefik mit HTTPS erreichbar ist, etwa daten.example.org.
# Nur der Name: ohne https://, ohne Pfad, ohne Port. Jede App braucht ihren eigenen Namen:
# Zwei Apps mit derselben Domain verdrängen sich bei Traefik, egal auf welchem Port.
DOMAIN=

# Ohne Domain direkt über einen Port erreichbar machen, etwa HOST_PORT=8090 (dann
# http://<server>:8090, ohne HTTPS) und TRAEFIK_ENABLE=false. Leer: nur auf dem Server
# selbst unter 127.0.0.1:18080.
HOST_PORT=
TRAEFIK_ENABLE=

# Passwort des Admin-Zugangs. Leer: Beim ersten Start entsteht ein zufälliges im
# Datenvolume (anzeigen: docker compose exec app cat /data/admin.password).
WDA_ADMIN_PASSWORD=

# Optional: zweites Passwort nur zum Ansehen abgelegter Läufe und Berichte (Lesezugang).
WDA_VIEWER_PASSWORD=

# Adresse der App von außen mit https://, für Links in verschickten Berichten.
WDA_PUBLIC_URL=

# Sprachmodell (OpenAI-kompatibel). Adresse, Modell und Schlüssel lassen sich auch in der
# App unter Einstellungen eintragen. Leer: Adresse von OpenAI, Modell laut Voreinstellung.
WDA_LLM_BASE_URL=
WDA_LLM_MODEL=
WDA_LLM_API_KEY=
# Leer (in diesem Stack: on) lassen sich die drei Werte auch in der App eintragen. off: Die
# App zeigt sie nur an, es gelten allein die Werte von hier.
WDA_LLM_SETTINGS_UI=

# Versand von Berichten nach Zeitplan per E-Mail. Ohne Host gibt es keine E-Mails.
# WDA_SMTP_SECURITY: starttls (Port 587), ssl (Port 465) oder none.
WDA_SMTP_HOST=
WDA_SMTP_PORT=
WDA_SMTP_USER=
WDA_SMTP_PASSWORD=
WDA_SMTP_FROM=
WDA_SMTP_SECURITY=

# Uhrzeit (HH:MM), zu der Abzüge nachgezogen und schwere Auswertungen neu gezählt werden;
# off schaltet beides ab. WDA_PRECOMPUTE nennt die Auswertungen (IDs, durch Komma getrennt);
# WDA_PRECOMPUTE=off schaltet nur das Vorrechnen ab.
WDA_SNAPSHOT_NIGHTLY=
WDA_PRECOMPUTE=
WDA_TIMEZONE=

# Weitere edu-sharing-Instanzen als JSON-Liste; WLO Produktion und Staging sind vorbelegt.
# Beispiel: [{"id":"meine","name":"Meine Instanz","base_url":"https://edu.beispiel.de","metadataset":"mds"}]
WDA_INSTANCES=

# Port, auf dem die App im Container lauscht. Leer: 8080. Ein anderer Wert hilft, wenn eine
# andere App im selben Docker-Netz schon 8080 benutzt; Traefik folgt ihm von selbst.
WDA_PORT=

# Leer (auto): Das Anmelde-Cookie ist über HTTPS geschützt und geht über einen Port ohne
# HTTPS trotzdem. true: nur über HTTPS.
WDA_COOKIE_SECURE=

# Feineinstellungen; leer gelten die Vorgaben der App (Bedeutung und Vorgaben: README,
# Abschnitt Konfiguration). WDA_SCHEDULER=off schaltet Zeitpläne und nächtliche Aufgaben ab.
# WDA_SESSION_SECRET bleibt in der Regel leer: Die App legt ihr Geheimnis im Datenvolume an.
WDA_SCHEDULER=
WDA_RUNS_KEEP=
WDA_SESSION_MAX_AGE=
WDA_SESSION_SECRET=
WDA_LLM_EFFORT=
WDA_CACHE_TTL=
WDA_VOCAB_TTL=
WDA_UPSTREAM_TIMEOUT=
WDA_UPSTREAM_CONCURRENCY=
WDA_SNAPSHOT_PAGE=
WDA_OERSI_URL=

# Traefik: Netz, Entrypoint und Zertifikatsdienst. Leer passt zum Docker Manager von Hostinger.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=

# Anderes Image, etwa eine feste Version: ghcr.io/janschachtschabel/wlo-data-analysis:1.2.0
WDA_IMAGE=
