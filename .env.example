# Pflicht: Passwort des einzigen Admin-Zugangs. Ohne diesen Wert startet die App nicht.
WDA_ADMIN_PASSWORD=

# Auf false setzen, wenn die App lokal ohne HTTPS aufgerufen wird (http://localhost:8080).
WDA_COOKIE_SECURE=true

# Optional: festes Session-Geheimnis. Ohne Angabe wird eines im Datenverzeichnis abgelegt.
# WDA_SESSION_SECRET=

# KI-Anbindung (OpenAI-kompatibel). Standard ist OpenAI mit gpt-6-luna.
# Für die B-API z. B.: WDA_LLM_BASE_URL=https://<b-api-host>/api/v1/llm/openai
WDA_LLM_BASE_URL=https://api.openai.com/v1
WDA_LLM_MODEL=gpt-6-luna
WDA_LLM_API_KEY=

# Optional: weitere edu-sharing-Instanzen als JSON-Liste. WLO Produktion (wlo-prod)
# und WLO Staging (wlo-staging) sind vorbelegt.
# WDA_INSTANCES=[{"id":"meine","name":"Meine Instanz","base_url":"https://edu.example.org","metadataset":"mds"}]
